NEXT_PUBLIC_APP_NAME="Next.js Multitenant"
NEXT_PUBLIC_APP_URL="localhost:3000"
# Dominio raíz de la plataforma. Subdominios *.domain.com son tenants.
# En desarrollo local usar "localhost" (sin protocolo, sin puerto).
# En producción cambiar a "domain.com".
NEXT_PUBLIC_ROOT_DOMAIN="localhost"

BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Subdominios de tenant permitidos. En producción cambiar a "https://*.domain.com"
BETTER_AUTH_TRUSTED_ORIGINS="http://*.localhost:3000"

# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Google (opcional, para OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend
RESEND_API_KEY=""
EMAIL_SENDER_NAME="Tu App"
EMAIL_SENDER_ADDRESS="no-reply@tuapp.com"
